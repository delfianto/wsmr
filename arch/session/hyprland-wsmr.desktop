# Real (non-E2E) wayland-sessions entry for a normal /usr/bin/wsmr install,
# installed by arch/PKGBUILD's package(). Modeled directly on the real,
# package-shipped hyprland-uwsm.desktop (/usr/share/wayland-sessions/, from
# the `uwsm` Arch package) — same shape, `wsmr` swapped in for `uwsm`.
#
# wsmr is compositor-agnostic like uwsm; this entry is Hyprland-specific
# because that's what this package's target system runs. A different
# compositor needs its own entry with the same Exec/TryExec shape.
[Desktop Entry]
Name=Hyprland (wsmr-managed)
Comment=An intelligent dynamic tiling Wayland compositor
Exec=wsmr start -e -D Hyprland hyprland.desktop
TryExec=wsmr
DesktopNames=Hyprland
Type=Application
