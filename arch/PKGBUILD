pkgname=wsmr
pkgver=0.2.0
pkgrel=1
pkgdesc='Systemd-managed Wayland session manager'
arch=('x86_64')
url='https://github.com/delfianto/wsmr'
license=('MIT')
depends=('glibc' 'libgcc' 'systemd' 'dbus')
options=('!strip' '!debug')
_archive="wsmr-v$pkgver-linux-x86_64"
source=("$url/releases/download/v$pkgver/$_archive.tar.gz")
sha256sums=('f69c4f9cefc4297079860c1f3e948c9ac33a0fccb01a944a2e3af00069eb92ba')

package() {
    cd "$srcdir/$_archive"
    install -Dm0755 wsmr "$pkgdir/usr/local/bin/wsmr"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    local docdir="$pkgdir/usr/share/doc/$pkgname"
    install -Dm0644 THIRD-PARTY-LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES"
    install -Dm0644 README.md "$docdir/README.md"
    install -dm0755 "$docdir"
    cp -a docs arch "$docdir/"
    install -Dm0644 hyprland-wsmr.desktop "$pkgdir/usr/share/wayland-sessions/hyprland-wsmr.desktop"
}
